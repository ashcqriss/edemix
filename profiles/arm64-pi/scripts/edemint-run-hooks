#!/bin/sh
# Edemint Pi-image hook runner. Shared hooks are release-critical: a hook
# failure must abort the build rather than produce a successful but unusable
# image. The shared 0050 hook installs and verifies the required desktop stack.
set -eu

HOOK_DIR=/usr/local/share/edemint-hooks
MANIFEST=/usr/share/edemint/required-desktop.packages

[ -s "$MANIFEST" ] || {
    echo "edemint-run-hooks: missing required desktop manifest: $MANIFEST" >&2
    exit 1
}
[ -d "$HOOK_DIR" ] || {
    echo "edemint-run-hooks: no $HOOK_DIR" >&2
    exit 1
}

found=0
failed=0
for hook in "$HOOK_DIR"/*.hook.chroot; do
    [ -f "$hook" ] || continue
    found=1
    echo "edemint-run-hooks: $hook"
    if ! sh "$hook"; then
        echo "edemint-run-hooks: $hook FAILED" >&2
        failed=1
    fi
done

[ "$found" -eq 1 ] || {
    echo "edemint-run-hooks: nothing matched $HOOK_DIR/*.hook.chroot" >&2
    exit 1
}
[ "$failed" -eq 0 ] || exit 1
