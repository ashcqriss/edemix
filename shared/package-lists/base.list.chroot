# Edemint base - system plumbing, before any GUI.
# Kept lean enough for the Pi / 1GB-class targets (zram + earlyoom make
# low-RAM survivable; see section 0d of the plan).

# --- init / networking ---------------------------------------------------
systemd-sysv
network-manager
modemmanager

# --- firmware (the non-free-firmware archive area is enabled in auto/config)
# Without these most Wi-Fi/GPUs are dead on first boot. apt-recommends is off,
# so list the firmware packages explicitly rather than relying on metapackages.
firmware-misc-nonfree
firmware-iwlwifi
firmware-realtek
firmware-atheros
firmware-amd-graphics
firmware-brcm80211
wireless-regdb

# CPU microcode (Intel + AMD) is shipped only on amd64.

# --- bluetooth (stack only; GUI lives in desktop.list) ------------------
bluez
libspa-0.2-bluetooth

# --- power management ---------------------------------------------------
power-profiles-daemon

# --- printing services (CUPS bound to localhost in includes) ------------
cups
cups-browsed
avahi-daemon

# --- essential CLI userland ---------------------------------------------
sudo
nano
neovim
less
file
ca-certificates
curl
wget
git
htop
pciutils
usbutils
xz-utils
zstd

# --- audio (pipewire) ----------------------------------------------------
pipewire
pipewire-pulse
wireplumber

# --- filesystems / disk -------------------------------------------------
gdisk
dosfstools
e2fsprogs
ntfs-3g
exfatprogs
btrfs-progs
udisks2
cryptsetup
lvm2

# --- i18n: preserve the complete Debian locale data ---------------------
# Edemint is a general-purpose OS. Do not use localepurge: users must be able
# to select supported languages without repairing packages first.
locales
tzdata

# --- low-RAM resilience -------------------------------------------------
zram-tools
earlyoom

# --- security defaults --------------------------------------------------
apparmor
apparmor-profiles
nftables
unattended-upgrades
apt-listchanges

# --- credential store + PAM integration --------------------------------
gnome-keyring
libpam-gnome-keyring

# --- notify-send ---------------------------------------------------------
libnotify-bin

# --- whiptail (TUI for edemint-setup) -----------------------------------
whiptail

# --- fingerprint auth - driver only; PAM wired in includes --------------
fprintd
libpam-fprintd
