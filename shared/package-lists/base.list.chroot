# Edemint base - system plumbing, before any GUI.
# Kept lean enough for the Pi / 1GB-class targets (zram + earlyoom make
# low-RAM survivable; see section 0d of the plan).

# --- init / networking ---------------------------------------------------
systemd-sysv
network-manager
modemmanager

# --- firmware ------------------------------------------------------------
firmware-misc-nonfree
firmware-iwlwifi
firmware-realtek
firmware-atheros
firmware-amd-graphics
firmware-brcm80211
wireless-regdb

# CPU microcode (Intel + AMD) is shipped only on amd64.

# --- bluetooth -----------------------------------------------------------
bluez
libspa-0.2-bluetooth

# --- power management ---------------------------------------------------
power-profiles-daemon

# --- printing services --------------------------------------------------
cups
cups-browsed
avahi-daemon

# --- essential CLI userland ---------------------------------------------
sudo
nano
neovim
less
file
ca-certificates
curl
wget
git
htop
procps
pciutils
usbutils
smartmontools
xz-utils
zstd

# --- audio ---------------------------------------------------------------
pipewire
pipewire-pulse
wireplumber

# --- filesystems / disk -------------------------------------------------
gdisk
dosfstools
e2fsprogs
ntfs-3g
exfatprogs
btrfs-progs
udisks2
cryptsetup
lvm2

# --- i18n: preserve the complete Debian locale data ---------------------
# Edemint is a general-purpose OS. Users must be able to select supported
# languages without first repairing package contents.
locales
tzdata

# --- low-RAM resilience -------------------------------------------------
zram-tools
earlyoom

# --- security defaults --------------------------------------------------
apparmor
apparmor-profiles
nftables
unattended-upgrades
apt-listchanges

# --- credential store + PAM integration --------------------------------
gnome-keyring
libpam-gnome-keyring

# --- notify-send ---------------------------------------------------------
libnotify-bin

# --- whiptail ------------------------------------------------------------
whiptail

# --- fingerprint auth ---------------------------------------------------
fprintd
libpam-fprintd
