#!/bin/sh
# Install the release-critical desktop stack and then optional conveniences.
# Required packages are deliberately hard-fail: an image without its
# compositor, portal, locker, idle daemon, or configured shell utilities is
# not a usable Edemint image.
set -eu

MANIFEST=/usr/share/edemint/required-desktop.packages
[ -s "$MANIFEST" ] || {
    echo "edemint: missing required desktop manifest: $MANIFEST" >&2
    exit 1
}

cat > /etc/apt/sources.list.d/debian-backports.sources <<'EOF'
Types: deb
URIs: http://deb.debian.org/debian
Suites: trixie-backports
Components: main
Signed-By: /usr/share/keyrings/debian-archive-keyring.gpg
EOF

cat > /etc/apt/preferences.d/90-edemint-backports <<'EOF'
Package: *
Pin: release n=trixie-backports
Pin-Priority: 100
EOF

apt-get update

install_suite() {
    suite="$1"
    packages="$(awk -v suite="$suite" '
        /^[[:space:]]*(#|$)/ { next }
        $2 == suite { print $1 }
    ' "$MANIFEST" | tr '\n' ' ')"
    [ -z "$packages" ] || {
        echo "edemint: installing required desktop packages from $suite:$packages"
        # Package splitting is intentional.
        # shellcheck disable=SC2086
        apt-get install -y --no-install-recommends -t "$suite" $packages
    }
}

install_suite trixie-backports
install_suite trixie

missing=0
while read -r package suite extra; do
    case "$package" in ''|'#'*) continue ;; esac
    if [ -n "${extra:-}" ] || [ -z "${suite:-}" ]; then
        echo "edemint: malformed required package entry: $package ${suite:-} ${extra:-}" >&2
        missing=1
    elif ! dpkg-query -W -f='${db:Status-Status}\n' "$package" 2>/dev/null | grep -qx installed; then
        echo "edemint: required package was not installed: $package" >&2
        missing=1
    fi
done < "$MANIFEST"
[ "$missing" -eq 0 ] || exit 1

for command in Hyprland hyprlock hypridle wlogout swayosd-server cliphist wf-recorder jq; do
    command -v "$command" >/dev/null 2>&1 || {
        echo "edemint: required desktop command is missing: $command" >&2
        exit 1
    }
done

# Live ISO only: enter the desktop directly. The Pi has a flash-kernel machine
# marker and is instead gated by first-boot owner provisioning. Calamares
# replaces this file with the password-gated greeter on installed systems.
if [ ! -s /etc/flash-kernel/machine ]; then
    cat > /etc/greetd/config.toml <<'EOF'
[terminal]
vt = 1

[initial_session]
command = "Hyprland"
user = "edemint"

[default_session]
command = "sh -c 'command -v tuigreet >/dev/null 2>&1 && exec tuigreet --time --remember --cmd Hyprland || exec agreety --cmd Hyprland'"
user = "greetd"
EOF
fi

# These packages improve the experience but are not needed to start, lock, or
# operate the graphical session. Their absence is visible in the build log.
OPTIONAL="
greetd-tuigreet
hyprpicker
distrobox
fastfetch
grub-btrfs
ollama
"

ok=""
skip=""
for package in $OPTIONAL; do
    if apt-get install -y --no-install-recommends "$package" >/dev/null 2>&1; then
        ok="$ok $package"
    else
        skip="$skip $package"
    fi
done

echo "edemint optional desktop packages installed:${ok:- (none)}"
[ -z "$skip" ] || echo "edemint optional desktop packages unavailable:${skip}"
