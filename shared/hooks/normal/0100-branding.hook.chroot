#!/bin/sh
# Edemint branding + service enablement. Runs inside the chroot during build.
# Owns: os identity, lsb-release, apt sources, service enable/disable,
# CUPS localhost bind, PAM keyring wiring, image slimming.
set -e

# --- OS identity ---------------------------------------------------------
cat > /usr/lib/os-release <<'EOF'
PRETTY_NAME="Edemint 0.1"
NAME="Edemint"
VERSION_ID="0.1"
VERSION="0.1 (origin)"
VERSION_CODENAME=trixie
ID=edemint
ID_LIKE=debian
HOME_URL="https://example.invalid/edemint"
SUPPORT_URL="https://example.invalid/edemint"
BUG_REPORT_URL="https://example.invalid/edemint/issues"
EOF
ln -sf ../usr/lib/os-release /etc/os-release

cat > /etc/lsb-release <<'EOF'
DISTRIB_ID=Edemint
DISTRIB_RELEASE=0.1
DISTRIB_CODENAME=origin
DISTRIB_DESCRIPTION="Edemint 0.1"
EOF

cat > /etc/issue <<'EOF'
Edemint 0.1 \n \l

EOF
cp /etc/issue /etc/issue.net

# Default hostname (Calamares overrides on install)
echo "edemint" > /etc/hostname

# motd
cat > /etc/motd <<'EOF'

  Edemint — a Wayland-first Debian remix for AR glasses and small machines.
  Super+Return = terminal   Super+D = launcher   Super+? = keybind help

EOF

# --- apt sources: Debian Trixie + non-free-firmware ----------------------
# Use deb822 in /etc/apt/sources.list.d/ and clear the legacy file.
cat > /etc/apt/sources.list.d/debian.sources <<'EOF'
Types: deb
URIs: http://deb.debian.org/debian
Suites: trixie trixie-updates
Components: main contrib non-free non-free-firmware
Signed-By: /usr/share/keyrings/debian-archive-keyring.gpg

Types: deb
URIs: http://security.debian.org/debian-security
Suites: trixie-security
Components: main contrib non-free non-free-firmware
Signed-By: /usr/share/keyrings/debian-archive-keyring.gpg
EOF
: > /etc/apt/sources.list

# Edemint repo keyring placeholder. The real public key lands here when CI
# (§12) replaces the placeholder via the build artifact; the deb822 source
# in /etc/apt/sources.list.d/edemint.sources references this path.
install -d -m 0755 /etc/apt/keyrings
touch /etc/apt/keyrings/edemint-archive-keyring.gpg
chmod 0644 /etc/apt/keyrings/edemint-archive-keyring.gpg

# --- CUPS: bind TCP listen to localhost only (§6e) ----------------------
# Only rewrite TCP Listen lines (Listen *:631, Listen 0.0.0.0:631, etc.).
# The Unix-socket Listen (Listen /run/cups/cups.sock) MUST stay intact —
# every CUPS client reaches the daemon over that socket.
if [ -f /etc/cups/cupsd.conf ]; then
    sed -i \
        -e 's|^Listen \*:631.*|Listen localhost:631|' \
        -e 's|^Listen 0\.0\.0\.0:631.*|Listen localhost:631|' \
        -e 's|^Port 631.*|Listen localhost:631|' \
        /etc/cups/cupsd.conf
fi

# --- AR group — created here so Calamares 'users' module can add the user
#     even if the XR-driver hook later skips (offline / SHA mismatch).
getent group edemint-ar >/dev/null || groupadd --system edemint-ar

# --- PAM: wire the keyring snippet into login + greetd only -------------
# sudo intentionally NOT touched: gnome-keyring auto-unlock is a login-time
# concern; adding it to sudo's auth stack widens the attack surface for
# no real benefit (the keyring is already unlocked by then).
for stack in login greetd; do
    pf="/etc/pam.d/$stack"
    [ -f "$pf" ] || continue
    grep -q 'edemint-keyring' "$pf" || \
        printf '\n# Edemint: unlock gnome-keyring at login\n@include edemint-keyring\n' >> "$pf"
done

# --- Services ------------------------------------------------------------
# Enable
systemctl enable greetd.service             || true
systemctl set-default graphical.target      || true
systemctl enable bluetooth.service          || true
systemctl enable cups.service               || true
systemctl enable cups-browsed.service       || true
systemctl enable avahi-daemon.service       || true
systemctl enable nftables.service           || true
systemctl enable apparmor.service           || true
systemctl enable unattended-upgrades.service|| true
systemctl enable zramswap.service           || true
systemctl enable earlyoom.service           || true
systemctl enable systemd-timesyncd.service  || true
systemctl enable ModemManager.service       || true
systemctl enable power-profiles-daemon.service || true
systemctl enable fprintd.service            || true
systemctl enable tmp.mount                  || true
systemctl enable fstrim.timer               || true

# Disable: NetworkManager-wait-online stalls boot for up to 30s waiting
# for a routable IP — desktops don't need that as a boot barrier. Also
# disable plymouth-quit-wait (saves ~1s; plymouth already exits with the
# greeter starting).
systemctl disable NetworkManager-wait-online.service 2>/dev/null || true
systemctl mask    plymouth-quit-wait.service        2>/dev/null || true

# --- Locale trim (§optim) — clip ~150MB of unused-locale files ----------
if command -v localepurge >/dev/null 2>&1; then
    localepurge 2>/dev/null || true
fi

# --- Regenerate initramfs with the MODULES=dep + zstd settings ----------
if command -v update-initramfs >/dev/null 2>&1; then
    update-initramfs -u -k all 2>/dev/null || true
fi

# Live media only: enable autologin via greetd; the Calamares 'finished'
# step (§6b) removes the autologin drop-in so installed disks always show
# the greeter.
mkdir -p /etc/greetd
# The shipped config.toml already wires autologin — left intact here.

# --- Slim the image ------------------------------------------------------
apt-get clean || true
rm -rf /usr/share/doc/* /var/lib/apt/lists/* || true
