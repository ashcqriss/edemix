#!/bin/sh
# live-build's Ubuntu 3.0~a57 lb_binary_syslinux copies BIOS
# bootloader files from /root/isolinux inside the chroot. Current
# Debian packages keep them under /usr/lib, while Ubuntu live-build also
# ships template copies under /usr/share/live/build/bootloaders.
set -eu

arch="$(dpkg --print-architecture 2>/dev/null || echo unknown)"
if [ "$arch" != "amd64" ]; then
    echo "0850-isolinux-compat: skipping ISO-only hook on $arch"
    exit 0
fi

mkdir -p /root/isolinux

copy_first() {
    dst="$1"
    shift

    for src in "$@"; do
        if [ -e "$src" ]; then
            rm -f "$dst"
            cp -Lf "$src" "$dst"
            return 0
        fi
    done

    if [ -s "$dst" ]; then
        return 0
    fi

    echo "0850-isolinux-compat: missing $dst" >&2
    exit 1
}

copy_first /root/isolinux/isolinux.bin \
    /usr/lib/ISOLINUX/isolinux.bin \
    /usr/lib/syslinux/isolinux.bin \
    /usr/share/syslinux/isolinux.bin

copy_first /root/isolinux/vesamenu.c32 \
    /usr/lib/syslinux/modules/bios/vesamenu.c32 \
    /usr/lib/syslinux/vesamenu.c32 \
    /usr/share/syslinux/vesamenu.c32

echo "0850-isolinux-compat: prepared /root/isolinux legacy files"
