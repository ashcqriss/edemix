#!/bin/sh
# live-build's Ubuntu 3.0~a57 lb_binary_syslinux copies BIOS
# bootloader files from /root/isolinux inside the chroot. Current
# Debian packages keep them under /usr/lib, so provide the legacy paths
# before the binary syslinux stage runs.
set -e

mkdir -p /root/isolinux

link_first() {
    dst="$1"
    shift
    fallback="$1"

    for src in "$@"; do
        if [ -e "$src" ]; then
            ln -sf "$src" "$dst"
            return 0
        fi
    done

    ln -sf "$fallback" "$dst"
}

link_first /root/isolinux/isolinux.bin \
    /usr/lib/ISOLINUX/isolinux.bin \
    /usr/lib/syslinux/isolinux.bin \
    /usr/share/syslinux/isolinux.bin

link_first /root/isolinux/vesamenu.c32 \
    /usr/lib/syslinux/modules/bios/vesamenu.c32 \
    /usr/lib/syslinux/vesamenu.c32 \
    /usr/share/syslinux/vesamenu.c32

echo "0850-isolinux-compat: prepared /root/isolinux legacy links"
