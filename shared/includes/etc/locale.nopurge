# Edemint localepurge config — read by localepurge(8) at install time.
# Listed locales are KEPT; everything else is purged. Trims ~150MB.
# Users can re-add locales with `sudo dpkg-reconfigure localepurge`.

# Run on every dpkg invocation, quietly, after showing freed space.
USE_DPKG
SHOWFREEDSPACE
QUICKNDIRTY
# Note: NEEDSCONFIGFIRST intentionally omitted — that flag makes
# localepurge refuse to run until manually configured. We've already
# configured it (this file).

# Locales to keep
en
en_US
en_US.UTF-8
en_GB
en_GB.UTF-8
