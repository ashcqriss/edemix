{
    "layer": "top",
    "position": "top",
    "height": 28,
    "modules-left":   ["hyprland/workspaces", "custom/ai-privacy"],
    "modules-center": ["clock"],
    "modules-right":  ["tray", "pulseaudio", "network", "cpu", "memory", "battery"],

    "hyprland/workspaces": {
        "format": "{id}"
    },
    "clock": {
        "format": "{:%a %d %b  %H:%M}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },
    "cpu": {
        "format": "  {usage}%"
    },
    "memory": {
        "format": "  {}%"
    },
    "battery": {
        "format": "{capacity}% {icon}",
        "format-icons": ["", "", "", "", ""]
    },
    "network": {
        "format-wifi": "  {essid}",
        "format-ethernet": "  wired",
        "format-disconnected": "  off"
    },
    "pulseaudio": {
        "format": "{volume}% {icon}",
        "format-muted": "muted",
        "format-icons": {"default": ["", "", ""]},
        "on-click": "pavucontrol"
    },
    "tray": {
        "spacing": 6,
        "icon-size": 16
    },
    "custom/ai-privacy": {
        "exec":       "edemint-ai-privacy",
        "return-type": "json",
        "interval":    1,
        "on-click":    "foot -T 'Edemint AI' -e edemint-ai status",
        "tooltip":     true
    }
}
