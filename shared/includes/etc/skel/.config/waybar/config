{
    "name": "edemint-status",
    "layer": "top",
    "position": "top",
    "height": 36,
    "spacing": 6,
    "margin-top": 12,
    "margin-right": 14,
    "modules-left": [],
    "modules-center": [],
    "modules-right": [
        "clock",
        "custom/ai-privacy",
        "custom/cam-mic",
        "custom/updates",
        "tray",
        "pulseaudio",
        "network",
        "cpu",
        "memory",
        "battery"
    ],

    "clock": {
        "format": "{:%a %d %b  %H:%M}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },
    "cpu": {
        "format": "CPU {usage}%"
    },
    "memory": {
        "format": "RAM {}%"
    },
    "battery": {
        "format": "BAT {capacity}%",
        "format-charging": "BAT +{capacity}%"
    },
    "network": {
        "format-wifi": "NET {essid}",
        "format-ethernet": "NET wired",
        "format-disconnected": "NET off"
    },
    "pulseaudio": {
        "format": "VOL {volume}%",
        "format-muted": "VOL muted",
        "on-click": "pavucontrol"
    },
    "tray": {
        "spacing": 6,
        "icon-size": 16
    },
    "custom/ai-privacy": {
        "exec": "edemint-ai-privacy",
        "return-type": "json",
        "interval": 1,
        "on-click": "foot -T 'Edemint AI' -e edemint-ai status",
        "tooltip": true
    },
    "custom/cam-mic": {
        "exec": "edemint-privacy-status",
        "return-type": "json",
        "interval": 2,
        "tooltip": true
    },
    "custom/updates": {
        "exec": "edemint-updates-status",
        "return-type": "json",
        "interval": 300,
        "on-click": "edemint-updates-click",
        "tooltip": true
    }
}
