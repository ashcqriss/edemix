{
    "name": "edemint-status",
    "layer": "top",
    "position": "top",
    "height": 30,
    "spacing": 0,
    "modules-left": ["custom/logo", "hyprland/workspaces", "hyprland/window"],
    "modules-center": [],
    "modules-right": [
        "tray",
        "custom/ai-privacy",
        "custom/cam-mic",
        "custom/updates",
        "idle_inhibitor",
        "pulseaudio",
        "backlight",
        "network",
        "bluetooth",
        "cpu",
        "memory",
        "battery",
        "clock"
    ],

    "custom/logo": {
        "format": "E",
        "tooltip": false,
        "on-click": "edemint-quick",
        "on-click-right": "edemint-settings"
    },
    "hyprland/workspaces": {
        "format": "{id}",
        "on-click": "activate",
        "sort-by-number": true
    },
    "hyprland/window": {
        "format": "{title}",
        "max-length": 48,
        "separate-outputs": true
    },
    "clock": {
        "format": "{:%a %d %b  %H:%M}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "on-click": "edemint-quick"
    },
    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": { "activated": "STAY", "deactivated": "IDLE" },
        "tooltip-format-activated": "Idle inhibitor on — screen stays awake",
        "tooltip-format-deactivated": "Idle inhibitor off — normal idle/lock"
    },
    "cpu": {
        "format": "CPU {usage}%",
        "on-click": "foot -T 'System monitor' -e htop"
    },
    "memory": {
        "format": "RAM {}%",
        "on-click": "foot -T 'System monitor' -e htop"
    },
    "battery": {
        "format": "BAT {capacity}%",
        "format-charging": "BAT +{capacity}%",
        "on-click": "edemint-power-profile"
    },
    "backlight": {
        "format": "LUX {percent}%",
        "on-scroll-up": "brightnessctl set +5%",
        "on-scroll-down": "brightnessctl set 5%-"
    },
    "network": {
        "format-wifi": "NET {essid}",
        "format-ethernet": "NET wired",
        "format-disconnected": "NET off",
        "on-click": "foot -T 'Wi-Fi' -e nmtui-connect"
    },
    "bluetooth": {
        "format": "BT {status}",
        "format-connected": "BT {num_connections}",
        "format-disabled": "BT off",
        "on-click": "blueman-manager"
    },
    "pulseaudio": {
        "format": "VOL {volume}%",
        "format-muted": "VOL muted",
        "on-click": "pavucontrol"
    },
    "tray": {
        "spacing": 6,
        "icon-size": 16
    },
    "custom/ai-privacy": {
        "exec": "edemint-ai-privacy",
        "return-type": "json",
        "interval": 1,
        "on-click": "foot -T 'Edemint AI' -e edemint-ai status",
        "tooltip": true
    },
    "custom/cam-mic": {
        "exec": "edemint-privacy-status",
        "return-type": "json",
        "interval": 2,
        "tooltip": true
    },
    "custom/updates": {
        "exec": "edemint-updates-status",
        "return-type": "json",
        "interval": 300,
        "on-click": "edemint-updates-click",
        "tooltip": true
    }
}
