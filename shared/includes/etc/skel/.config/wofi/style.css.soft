/* Edemint all-apps completer — flat palette surfaces (docs/PALETTE.md):
 * navy-950 body, navy-700 input, ultramarine selection, turquoise focus
 * border. Rounded rectangles are the default shape language; no gradients. */
/* SOFT accent variant (selection ultramarine-400); edemint-settings
 * copies style.css.bold/.soft over style.css.
 *
 * Floating glass: >= 0.80 alpha so entries stay legible over any app even
 * without blur; the full effects profile blurs behind it. */
window {
    font-family: "Noto Sans", sans-serif;
    font-size: 14px;
    background-color: rgba(23, 30, 84, 0.84);
    border: 2px solid rgba(116, 251, 234, 0.60);
    border-radius: 24px;
    color: #ffffff;
}

#outer-box {
    margin: 16px;
}

#input {
    padding: 8px 16px;
    border: none;
    border-radius: 18px;
    background-color: rgba(0, 44, 137, 0.72);
    color: #ffffff;
}

#input image {
    color: #aea3ff;
}

#scroll {
    margin-top: 12px;
}

#entry {
    padding: 8px 12px;
    border-radius: 14px;
    color: #ffffff;
}

#entry:selected {
    background-color: #6d58ff;
    outline: none;
}

#text {
    color: #ffffff;
}

#text:selected {
    color: #ffffff;
}
