/* Edemint GTK4/libadwaita app colors — light set from docs/PALETTE.md.
 * App content sits on near-white paper #F4F6FF (never raw #FFFFFF — see
 * the conscious ink/paper rule). Element hues stay fixed (navy-700 header
 * bars / sidebars / cards / popovers, ultramarine-500 filled accents);
 * standalone accent text drops to the DARK step #002c89 on paper.
 * edemint-settings copies gtk.css.dark / gtk.css.light over gtk.css.
 * Flat fills only. */
@define-color window_bg_color #f4f6ff;
@define-color window_fg_color #0c0f1d;
@define-color view_bg_color #f4f6ff;
@define-color view_fg_color #0c0f1d;
@define-color dialog_bg_color #f4f6ff;
@define-color dialog_fg_color #0c0f1d;
@define-color headerbar_bg_color #002c89;
@define-color headerbar_fg_color #ffffff;
@define-color sidebar_bg_color #002c89;
@define-color sidebar_fg_color #ffffff;
@define-color card_bg_color #002c89;
@define-color card_fg_color #ffffff;
@define-color popover_bg_color #002c89;
@define-color popover_fg_color #ffffff;
@define-color accent_bg_color #2001ff;
@define-color accent_fg_color #ffffff;
@define-color accent_color #002c89;
@define-color destructive_bg_color #e31515;
@define-color destructive_fg_color #ffffff;
@define-color destructive_color #b32b2b;
@define-color success_color #21920f;
@define-color warning_color #b67e29;
@define-color error_color #b32b2b;
