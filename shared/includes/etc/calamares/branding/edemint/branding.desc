---
componentName: edemint

# Welcome / strings shown across the installer
strings:
    productName:        Edemint
    shortProductName:   Edemint
    version:            0.1
    shortVersion:       0.1
    versionedName:      Edemint 0.1 "Origin"
    shortVersionedName: Edemint 0.1
    bootloaderEntryName: Edemint
    productUrl:         https://example.invalid/edemint
    supportUrl:         https://example.invalid/edemint/support
    knownIssuesUrl:     https://example.invalid/edemint/issues
    releaseNotesUrl:    https://example.invalid/edemint/release-notes
    donateUrl:          https://example.invalid/edemint/donate

# Image slots (real art replaces these in the deferred design pass).
images:
    productLogo:         logo.svg
    productIcon:         logo.svg
    productWelcome:      welcome.png
    productWallpaper:    wallpaper.png

# Layout / typography — placeholder values
style:
    sidebarBackground:    "#14161c"
    sidebarText:          "#ffffff"
    sidebarTextSelect:    "#33ccff"
    sidebarTextHighlight: "#00ff99"

slideshow: "show.qml"

# Welcome screen toggles
welcomeStyleCalamares:        true
welcomeExpandingLogo:         true
windowExpanding:              normal
windowSize:                   800px,520px
windowPlacement:              center

# Bootloader entry strings
bootloaderEntryName: Edemint
