---
componentName: edemint

# Welcome / strings shown across the installer
strings:
    productName:        Edemint
    shortProductName:   Edemint
    version:            0.1
    shortVersion:       0.1
    versionedName:      Edemint 0.1 "Origin"
    shortVersionedName: Edemint 0.1
    bootloaderEntryName: Edemint
    productUrl:         https://github.com/ashcqriss/edemint
    supportUrl:         https://github.com/ashcqriss/edemint/discussions
    knownIssuesUrl:     https://github.com/ashcqriss/edemint/issues
    releaseNotesUrl:    https://github.com/ashcqriss/edemint/releases
    donateUrl:          https://github.com/sponsors/ashcqriss

# Image slots (real art replaces these in the deferred design pass).
# Only reference files we actually ship — Calamares warns/errors on
# missing image paths.
images:
    productLogo:         logo.svg
    productIcon:         logo.svg

# Layout / typography — first-build values from docs/PALETTE.md.
# sidebarTextSelect is the text color drawn ON sidebarTextHighlight (the
# current-step background), so the pair must contrast with each other.
style:
    sidebarBackground:    "#171e54"
    sidebarText:          "#ffffff"
    sidebarTextSelect:    "#ffffff"
    sidebarTextHighlight: "#2001ff"

slideshow: "show.qml"

# Welcome screen toggles
welcomeStyleCalamares:        true
welcomeExpandingLogo:         true
windowExpanding:              normal
windowSize:                   800px,520px
windowPlacement:              center

# Bootloader entry strings
bootloaderEntryName: Edemint
