[Unit]
Description=Edemint /tmp on tmpfs (RAM-backed)
DefaultDependencies=no
Conflicts=umount.target
Before=local-fs.target umount.target
After=swap.target

[Mount]
What=tmpfs
Where=/tmp
Type=tmpfs
# 25% of RAM, exec allowed (some installers extract there), nodev/nosuid for safety.
Options=mode=1777,strictatime,nosuid,nodev,size=25%

[Install]
WantedBy=local-fs.target
