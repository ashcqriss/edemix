[Desktop Entry]
Version=1.0
Type=Application
Name=Phone
GenericName=Phone Calls
Comment=Manage contacts and hand calls to supported telephony backends
Exec=edemint-phone %u
Icon=call-start
Terminal=false
Categories=Network;Telephony;
MimeType=x-scheme-handler/tel;x-scheme-handler/sip;
StartupNotify=true
Keywords=phone;call;dialer;cellular;sip;contacts;favorites;modem;
X-Edemint-Native=true
X-Edemint-Maturity=experimental
