#!/bin/sh
# Edemint first-run welcome (§0h). Marks itself complete via a per-user
# stamp file; the autostart entry exits silently after the first run.
# Routes the message through mako (notify-send), with stdout as fallback.

STAMP="${XDG_DATA_HOME:-$HOME/.local/share}/edemint/welcome.done"
mkdir -p "$(dirname "$STAMP")"

if [ -e "$STAMP" ] && [ "${1:-}" != "--force" ]; then
    exit 0
fi

TITLE="Welcome to Edemint"
BODY="Super + ? — keybind cheat-sheet
Super + Return — terminal · Super + D — launcher · Super + E — files
Network: nm-applet in the tray. AR glasses: plug in over USB-C DP-Alt.
AI assistant ships disabled; run  edemint-ai enable  to opt in."

if command -v notify-send >/dev/null 2>&1; then
    notify-send -t 12000 -u normal -i computer "$TITLE" "$BODY"
else
    printf '%s\n\n%s\n' "$TITLE" "$BODY"
fi

touch "$STAMP"
