#!/usr/bin/python3
"""Edemint Inspector with bounded probing and disposable viewer isolation."""

from __future__ import annotations

import base64
import json
import os
from pathlib import Path
import shutil
import subprocess
import sys
import time

import gi

gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")
from gi.repository import Adw, Gtk  # noqa: E402


def load_design():
    """Locate the shared hydroganic design runtime; the app must run without it."""
    for base in (os.environ.get("EDEMINT_DESIGN_DIR"),
                 "/usr/share/edemint/design",
                 str(Path(__file__).resolve().parents[1] / "share/edemint/design")):
        if base and (Path(base) / "edemint_design.py").is_file():
            if base not in sys.path:
                sys.path.insert(0, base)
            break
    try:
        import edemint_design
        return edemint_design
    except Exception:
        return None


DESIGN = load_design()

APP_ID = "org.edemint.Inspector"
PROBE = "/usr/libexec/edemint-inspector-probe"
SANDBOX = "/usr/libexec/edemint-inspector-sandbox"
DEFAULT_TIMEOUT_SECONDS = 3.0
MAX_TIMEOUT_SECONDS = 10.0


def timeout_seconds() -> float:
    try:
        configured = float(os.environ.get(
            "EDEMINT_INSPECTOR_TIMEOUT", str(DEFAULT_TIMEOUT_SECONDS)
        ))
    except ValueError:
        configured = DEFAULT_TIMEOUT_SECONDS
    return max(1.0, min(configured, MAX_TIMEOUT_SECONDS))


def label(text: str, title: bool = False) -> Gtk.Label:
    widget = Gtk.Label(label=text, xalign=0, selectable=not title)
    widget.set_wrap(True)
    if title:
        widget.add_css_class("title-2")
    return widget


def probe(path: Path) -> tuple[dict[str, object] | None, str]:
    try:
        completed = subprocess.run(
            [sys.executable, PROBE, str(path)],
            check=False,
            capture_output=True,
            text=True,
            timeout=timeout_seconds(),
            env={
                "PATH": "/usr/bin:/bin",
                "LANG": os.environ.get("LANG", "C.UTF-8"),
            },
        )
    except subprocess.TimeoutExpired:
        return None, (
            f"Preview timed out after {timeout_seconds():g} seconds. "
            "The reader process was stopped."
        )
    except OSError as exc:
        return None, str(exc)

    try:
        payload = json.loads(completed.stdout)
    except (TypeError, ValueError):
        return None, "Inspector received an invalid response from its file probe."
    if not isinstance(payload, dict) or not payload.get("ok"):
        return None, str(payload.get("error", "The file cannot be inspected."))
    return payload, ""


class Inspector(Adw.Application):
    def __init__(self, arguments: list[str]) -> None:
        super().__init__(application_id=APP_ID)
        self.arguments = arguments
        self.window: Adw.ApplicationWindow | None = None

    def do_activate(self) -> None:
        if self.window:
            self.window.present()
            return
        self.window = Adw.ApplicationWindow(application=self)
        self.window.set_title("Inspector")
        self.window.set_default_size(920, 640)
        toolbar = Adw.ToolbarView()
        toolbar.add_top_bar(Adw.HeaderBar())
        toolbar.set_content(self.build_content())
        self.window.set_content(toolbar)
        if DESIGN:
            DESIGN.style_window(self.window, accent="turquoise")
        self.window.present()

    def notice(self, message: str) -> None:
        if self.window:
            dialog = Adw.AlertDialog(heading="Inspector", body=message)
            dialog.add_response("ok", "OK")
            dialog.present(self.window)

    def launch_sandbox(self, path: str, expected: str) -> None:
        try:
            preflight = subprocess.run(
                [sys.executable, SANDBOX, "--check", "--expect", expected, path],
                check=False,
                capture_output=True,
                text=True,
                timeout=4,
            )
        except (OSError, subprocess.TimeoutExpired) as exc:
            self.notice(f"Sandbox preflight failed: {exc}")
            return
        if preflight.returncode != 0:
            self.notice(preflight.stderr.strip() or "No isolated viewer is available.")
            return
        try:
            subprocess.Popen(
                [sys.executable, SANDBOX, "--expect", expected, path],
                start_new_session=True,
            )
        except OSError as exc:
            self.notice(str(exc))

    def build_content(self) -> Gtk.Widget:
        box = Gtk.Box(
            orientation=Gtk.Orientation.VERTICAL,
            spacing=14,
            margin_top=20,
            margin_bottom=20,
            margin_start=20,
            margin_end=20,
        )
        if not self.arguments:
            if DESIGN:
                box.append(DESIGN.hero("No file selected",
                                       "Open Inspector from Filer or run `edemint-inspector FILE`."))
            else:
                box.append(label("No file selected", True))
                box.append(label("Open Inspector from Filer or run `edemint-inspector FILE`."))
            return box

        payload, error = probe(Path(self.arguments[0]).expanduser())
        if not payload:
            box.append(label("File cannot be inspected", True))
            box.append(label(error))
            box.append(label(
                "Inspector refuses symbolic links and non-regular files, reads at "
                "most 64 KiB, and terminates a reader that exceeds its timeout."
            ))
            return box

        raw = base64.b64decode(str(payload["data"]), validate=True)
        text = raw.decode("utf-8", errors="replace")
        if "\x00" in text:
            text = raw[:4096].hex(" ")
        if payload.get("truncated"):
            text += "\n\n[Preview truncated at 65,536 bytes]"

        if DESIGN:
            box.append(DESIGN.hero(str(payload["name"]), str(payload["path"])))
        else:
            box.append(label(str(payload["name"]), True))
        facts = Adw.PreferencesGroup()
        for title, value in (
            ("Content type", str(payload["mime"])),
            ("Extension type", str(payload["extension_mime"])),
            ("Size", f"{payload['size']} bytes"),
            ("Modified", time.ctime(float(payload["modified"]))),
            ("Reader timeout", f"{timeout_seconds():g} seconds"),
        ):
            facts.add(Adw.ActionRow(title=title, subtitle=value))
        box.append(facts)
        if payload.get("mime_mismatch"):
            warning = label(
                "Warning: the file extension and detected content type disagree. "
                "Viewer selection follows the detected content, not the filename."
            )
            warning.add_css_class("ed-status-warn")
            box.append(warning)

        expected = f"{payload['device']}:{payload['inode']}"
        sandbox_button = Gtk.Button(label="Open Disposable Sandboxed Viewer")
        sandbox_button.add_css_class("suggested-action")
        sandbox_button.add_css_class("pill")
        sandbox_button.set_halign(Gtk.Align.CENTER)
        sandbox_button.set_tooltip_text(
            "Open the same file read-only without network, host D-Bus, host processes, or hardware devices"
        )
        sandbox_button.connect(
            "clicked",
            lambda _button: self.launch_sandbox(str(payload["path"]), expected),
        )
        sandbox_button.set_sensitive(Path(SANDBOX).is_file() and bool(shutil.which("bwrap")))
        box.append(sandbox_button)

        scanner = "available as an optional warning signal" if shutil.which("clamscan") else "not installed"
        policy = label(
            "Sandbox policy: one read-only file; private temporary home; no network; "
            "no host process namespace; no host D-Bus, SSH agent, password store, or "
            "hardware devices; all Linux capabilities dropped; bounded CPU, memory, "
            f"output size, process count, descriptors, and wall time. Malware scanner: {scanner}."
        )
        policy.add_css_class("dim-label")
        box.append(policy)

        buffer = Gtk.TextBuffer()
        buffer.set_text(text)
        view = Gtk.TextView(buffer=buffer, editable=False, monospace=True)
        view.set_wrap_mode(Gtk.WrapMode.WORD_CHAR)
        view.add_css_class("ed-mono")
        view.set_top_margin(10)
        view.set_bottom_margin(10)
        view.set_left_margin(12)
        view.set_right_margin(12)
        scroller = Gtk.ScrolledWindow(vexpand=True)
        scroller.set_child(view)
        scroller.add_css_class("ed-log")
        box.append(scroller)
        footnote = label(
            "The bounded preview never executes content or extracts archives. The optional "
            "viewer runs in a disposable namespace and cannot bypass the current user's Unix "
            "file permissions. Office documents use LibreOffice safe/view mode; audio is "
            "disabled in isolated media previews so no PipeWire device is exposed."
        )
        footnote.add_css_class("dim-label")
        box.append(footnote)
        return box


def main() -> int:
    return Inspector(sys.argv[1:]).run([sys.argv[0]])


if __name__ == "__main__":
    raise SystemExit(main())
