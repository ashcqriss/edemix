        boundary = self.group("Capability boundary")
        boundary.add(Adw.ActionRow(title="Immutable or A/B updates", subtitle="Not claimed. Recovery uses btrfs and Snapper only when the installed root supports them."))
        box.append(boundary)
        return scrolled(box)

    def page_security(self) -> Gtk.Widget:
        box = self.page_box("Security", "Read enforced service state, trust material and sandbox availability.")
        group = self.group("Protection status")
        group.add(self.output_row("AppArmor", ["sh", "-c", "systemctl is-active apparmor; aa-status 2>&1 | sed -n '1,20p'"]))
        group.add(self.output_row("Firewall", ["sh", "-c", "systemctl is-active nftables; nft list ruleset 2>&1 | sed -n '1,120p'"]))
        group.add(self.output_row("Disk encryption", ["lsblk", "-o", "NAME,TYPE,FSTYPE,MOUNTPOINTS"]))
        group.add(self.output_row("APT keyrings", ["sh", "-c", "find /usr/share/keyrings /etc/apt/keyrings -maxdepth 1 -type f -printf '%p\n' 2>/dev/null | sort"]))
        group.add(self.output_row("Sandbox components", ["sh", "-c", "command -v bwrap; command -v xdg-dbus-proxy; command -v edemint-inspector-sandbox"]))
        box.append(group)
        disclosure = self.group("Truthful status")
        disclosure.add(Adw.ActionRow(title="External evidence", subtitle="Secure Boot, physical hardware matrices, hosted repository operation, telephony, Fullcall networking and spatial AR remain gated until their external evidence exists."))
        box.append(disclosure)
        return scrolled(box)


def main() -> int:
    return Settings(sys.argv[1:]).run([sys.argv[0]])


if __name__ == "__main__":
    raise SystemExit(main())
