    def page_privacy(self) -> Gtk.Widget:
        box = self.page_box("Privacy", "Inspect sandbox permission records and control immediate microphone privacy.")
        group = self.group("Portal and Flatpak permissions", "Missing records are reported rather than treated as permission grants.")
        group.add(self.output_row("Permission table", ["flatpak", "permission-list"], 15))
        group.add(self.output_row("Recent portal activity", ["journalctl", "--user", "-u", "xdg-desktop-portal.service", "-n", "100", "--no-pager", "-o", "short-iso"], 10))
        box.append(group)
        _level, muted = self.volume_percent("@DEFAULT_AUDIO_SOURCE@")
        microphone = self.group("Microphone")
        microphone.add(self.switch_row("Global microphone mute", "Mute the default PipeWire input.", muted, lambda active: self.task("Changing microphone privacy", ["wpctl", "set-mute", "@DEFAULT_AUDIO_SOURCE@", "1" if active else "0"])))
        box.append(microphone)
        boundary = self.group("Capability boundary")
        boundary.add(Adw.ActionRow(title="Native permission broker", subtitle="Per-app native camera and microphone mediation is not claimed until a broker is installed and enforced."))
        box.append(boundary)
        return scrolled(box)

    @staticmethod
    def users_text() -> str:
        users = [f"{entry.pw_name} - {entry.pw_gecos or 'No display name'} - UID {entry.pw_uid}" for entry in pwd.getpwall() if entry.pw_uid >= 1000 and entry.pw_name != "nobody"]
        return "\n".join(users) or "No regular user accounts were found."

    def page_accounts(self) -> Gtk.Widget:
        box = self.page_box("Accounts", "Manage identity, passwords, fingerprints and local users through a validated helper.")
        current = pwd.getpwuid(os.getuid())
        group = self.group("Current account")
        group.add(Adw.ActionRow(title=current.pw_name, subtitle=current.pw_gecos or "Current user"))
        group.add(self.action_row("Change password", "Use the system password utility in a private terminal.", "Change", lambda: self.launch(["foot", "-T", "Change Password", "-e", "passwd"])))
        group.add(self.action_row("Enroll fingerprint", "Available only when supported hardware is reported by fprintd.", "Enroll", lambda: self.launch(["foot", "-T", "Fingerprint Enrollment", "-e", "fprintd-enroll"]), shutil.which("fprintd-enroll", path=BASE_PATH) is not None))
        box.append(group)
        accounts = self.group("Local accounts")
        accounts.add(Adw.ActionRow(title="Regular users", subtitle=self.users_text()))
        username = Gtk.Entry(placeholder_text="new-user")
        fullname = Gtk.Entry(placeholder_text="Display name")
        for title, widget in (("Username", username), ("Display name", fullname)):
            row = Adw.ActionRow(title=title)
            row.add_suffix(widget)
            accounts.add(row)

        def valid_name() -> str | None:
            name = username.get_text().strip()
            if not re.fullmatch(r"[a-z_][a-z0-9_-]{0,30}", name):
                self.notice("Accounts", "Enter a valid lowercase local username.")
                return None
            return name

        accounts.add(self.action_row("Create local account", "Create a home directory with the password initially locked.", "Create", lambda: self.admin_task("Creating account", ["add-user", valid_name(), fullname.get_text().strip()], done=lambda: self.notice("Accounts", "The account was created. Set its password before login.")) if valid_name() else None))
        accounts.add(self.action_row("Set account password", "Authenticate and set the password for the entered username.", "Set Password", lambda: self.launch(["foot", "-T", "Set Account Password", "-e", "pkexec", HELPER, "passwd-user", valid_name()]) if valid_name() else None))
        box.append(accounts)
        return scrolled(box)

    def page_language(self) -> Gtk.Widget:
        box = self.page_box("Language and Region", "Generate and select a locale, timezone, keyboard layout and network time policy.")
        group = self.group("Regional settings")
        locale_entry = Gtk.Entry(text=os.environ.get("LANG", "en_US.UTF-8"), placeholder_text="en_US.UTF-8")
        _code, timezone = capture(["timedatectl", "show", "--property=Timezone", "--value"])
        timezone_entry = Gtk.Entry(text=timezone.strip() if "/" in timezone else "Europe/Berlin", placeholder_text="Europe/Berlin")
        keyboard = Gtk.Entry(text=str(self.state.get("keyboard_layout", "us")), placeholder_text="us")
        for title, widget in (("Locale", locale_entry), ("Timezone", timezone_entry), ("Keyboard layout", keyboard)):
            row = Adw.ActionRow(title=title)
            widget.set_size_request(220, -1)
            row.add_suffix(widget)
            group.add(row)
        group.add(self.action_row("Apply locale", "Generate the supported locale and set the system default.", "Apply", lambda: self.admin_task("Applying locale", ["set-locale", locale_entry.get_text().strip()])))
        group.add(self.action_row("Apply timezone", "Use an installed IANA timezone.", "Apply", lambda: self.admin_task("Applying timezone", ["set-timezone", timezone_entry.get_text().strip()])))

        def apply_keyboard() -> None:
            layout = keyboard.get_text().strip()
            if not re.fullmatch(r"[A-Za-z0-9_-]{1,32}", layout):
                self.notice("Keyboard", "Enter a valid XKB layout name.")
                return
            self.state["keyboard_layout"] = layout
            save_state(self.state)
            write_hypr_override(self.state)
            capture(["hyprctl", "keyword", "input:kb_layout", layout])
            self.admin_task("Applying keyboard layout", ["set-keyboard", layout])

        group.add(self.action_row("Apply keyboard", "Persist for Edemint and update the current Hyprland session.", "Apply", apply_keyboard))
        _code, time_state = capture(["timedatectl", "show"])
        group.add(self.switch_row("Automatic network time", "Synchronize with systemd-timesyncd.", "NTP=yes" in time_state, lambda active: self.admin_task("Changing network time", ["set-ntp", "true" if active else "false"])))
        box.append(group)
        return scrolled(box)

    def page_accessibility(self) -> Gtk.Widget:
        box = self.page_box("Accessibility", "Keyboard-operable controls for large text, contrast, reduced motion and screen reading.")
        group = self.group("Visual and motion")
        _code, scale = capture(["gsettings", "get", "org.gnome.desktop.interface", "text-scaling-factor"])
        try:
            large = float(scale) > 1.01
        except ValueError:
            large = False
        group.add(self.switch_row("Large text", "Use a 1.25 interface text scale.", large, lambda active: self.task("Changing text scale", ["gsettings", "set", "org.gnome.desktop.interface", "text-scaling-factor", "1.25" if active else "1.0"])))
        _code, theme = capture(["gsettings", "get", "org.gnome.desktop.interface", "gtk-theme"])
        group.add(self.switch_row("High contrast", "Use the installed HighContrast GTK theme.", "HighContrast" in theme, lambda active: self.task("Changing contrast", ["gsettings", "set", "org.gnome.desktop.interface", "gtk-theme", "HighContrast" if active else "Adwaita"])))

        def reduce_motion(active: bool) -> None:
            self.state["reduced_motion"] = active
            save_state(self.state)
            write_hypr_override(self.state)
            capture(["gsettings", "set", "org.gnome.desktop.interface", "enable-animations", "false" if active else "true"])
            capture(["hyprctl", "keyword", "animations:enabled", "false" if active else "true"])
            self.status.set_label("Reduced-motion preference applied")

        group.add(self.switch_row("Reduce motion", "Disable GTK and Hyprland animations and persist the choice.", bool(self.state.get("reduced_motion", True)), reduce_motion))
        box.append(group)
        assistive = self.group("Assistive technology")
        assistive.add(self.action_row("Start Orca", "Launch the screen reader for this session.", "Start", lambda: self.launch(["orca"]), shutil.which("orca", path=BASE_PATH) is not None))
        assistive.add(self.action_row("Stop Orca", "Stop the current screen-reader process.", "Stop", lambda: self.task("Stopping Orca", ["pkill", "-x", "orca"])))
        assistive.add(self.action_row("Keyboard settings", "Open Language and Region.", "Open", lambda: self.select_page("language")))
        box.append(assistive)
        return scrolled(box)

    def page_updates(self) -> Gtk.Widget:
        box = self.page_box("Updates", "Review package changes, repository trust and release identity before installation.")
        group = self.group("Software updates")
        group.add(self.output_row("Available package changes", ["apt-get", "-s", "-o", "Debug::NoLocking=1", "upgrade"], 30))
        group.add(self.action_row("Refresh and install updates", "Refresh signed metadata and apply the full upgrade; configured Snapper hooks run automatically.", "Install", lambda: self.confirm("Install system updates?", "This authenticated operation refreshes repositories and upgrades installed packages.", lambda: self.admin_task("Installing updates", ["install-updates"], 7200))))
        group.add(self.action_row("Open rollback", "Select a Snapper snapshot and explicitly confirm rollback.", "Open", lambda: self.launch(["foot", "-T", "Edemint Rollback", "-e", "edemint-rollback"])))
        box.append(group)
        trust = self.group("Repository trust")
        trust.add(self.output_row("APT policy", ["apt-cache", "policy"], 20))
        trust.add(self.output_row("Configured sources", ["sh", "-c", "grep -RhsE '^(deb |Types:|URIs:|Suites:|Signed-By:)' /etc/apt/sources.list /etc/apt/sources.list.d 2>/dev/null || true"]))
        trust.add(self.output_row("Release identity", ["sh", "-c", "cat /etc/os-release; test -r /usr/share/doc/edemint/release-notes && cat /usr/share/doc/edemint/release-notes || true"]))
        box.append(trust)
        return scrolled(box)

