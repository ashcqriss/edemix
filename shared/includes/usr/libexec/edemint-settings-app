        group.add(self.action_row("Dismiss visible notifications", "Dismiss all currently held notifications.", "Dismiss", lambda: self.task("Dismissing notifications", ["makoctl", "dismiss", "-a"])))
        group.add(self.action_row("Restore last notification", "Restore the latest dismissed notification.", "Restore", lambda: self.task("Restoring notification", ["makoctl", "restore"])))
