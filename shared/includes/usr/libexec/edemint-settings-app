#!/usr/bin/python3
"""Edemint Settings: searchable, capability-aware system management."""

from __future__ import annotations

import json
import os
from pathlib import Path
import pwd
import re
import shutil
import subprocess
import sys
import threading
from typing import Callable

import gi

gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")
from gi.repository import Adw, Gio, GLib, Gtk  # noqa: E402


def load_design():
    """Locate the shared hydroganic design runtime; the app must run without it."""
    for base in (os.environ.get("EDEMINT_DESIGN_DIR"),
                 "/usr/share/edemint/design",
                 str(Path(__file__).resolve().parents[1] / "share/edemint/design")):
        if base and (Path(base) / "edemint_design.py").is_file():
            if base not in sys.path:
                sys.path.insert(0, base)
            break
    try:
        import edemint_design
        return edemint_design
    except Exception:
        return None


DESIGN = load_design()

APP_ID = "org.edemint.Settings"
HELPER = "/usr/libexec/edemint-settings-helper"
STATE_FILE = Path.home() / ".config/edemint/settings.json"
HYPR_OVERRIDE = Path.home() / ".config/hypr/edemint-settings.conf"
BASE_PATH = "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
SESSION_KEYS = (
    "HOME", "USER", "LOGNAME", "LANG", "LC_ALL", "XDG_RUNTIME_DIR",
    "XDG_CONFIG_HOME", "XDG_DATA_HOME", "XDG_CACHE_HOME", "XDG_DATA_DIRS",
    "XDG_CURRENT_DESKTOP", "XDG_SESSION_DESKTOP", "XDG_SESSION_TYPE",
    "XDG_SESSION_ID", "WAYLAND_DISPLAY", "DISPLAY", "DBUS_SESSION_BUS_ADDRESS",
)
PAGES = [
    ("overview", "Overview", "computer-symbolic",
     "system hardware identity diagnostics health"),
    ("connections", "Connections", "network-wireless-signal-excellent-symbolic",
     "network wifi ethernet vpn bluetooth radio"),
    ("sound", "Sound", "audio-volume-high-symbolic",
     "volume microphone input output mute pipewire"),
    ("display", "Display", "video-display-symbolic",
     "brightness monitor scale rotation refresh arrangement"),
    ("power", "Power", "battery-good-symbolic",
     "battery profile performance balanced saver"),
    ("notifications", "Notifications", "dialog-information-symbolic",
     "history do not disturb dnd alerts"),
    ("privacy", "Privacy", "security-high-symbolic",
     "permissions camera microphone portal flatpak history"),
    ("accounts", "Accounts", "system-users-symbolic",
     "users password fingerprint identity"),
    ("language", "Language and Region", "preferences-desktop-locale-symbolic",
     "locale timezone keyboard input date time"),
    ("accessibility", "Accessibility", "preferences-desktop-accessibility-symbolic",
     "screen reader contrast large text motion keyboard"),
    ("updates", "Updates", "software-update-available-symbolic",
     "packages sources trust release notes upgrade"),
    ("defaults", "Default Applications", "emblem-default-symbolic",
     "file association mime browser mail"),
    ("storage", "Storage", "drive-harddisk-symbolic",
     "disk smart space cleanup encryption removable"),
    ("backup", "Backup", "document-save-symbolic",
     "deja dup restore snapshots"),
    ("recovery", "Recovery", "edit-undo-symbolic",
     "snapper rollback snapshot repair"),
    ("security", "Security", "dialog-password-symbolic",
     "apparmor firewall keys sandbox status"),
]
PAGE_NAMES = {key for key, _title, _icon, _keywords in PAGES}


def session_env() -> dict[str, str]:
    env = {"PATH": BASE_PATH, "LANG": os.environ.get("LANG", "C.UTF-8")}
    for key in SESSION_KEYS:
        value = os.environ.get(key)
        if value:
            env[key] = value
    return env


def capture(argv: list[str], timeout: float = 8.0) -> tuple[int, str]:
    if not argv or not shutil.which(argv[0], path=BASE_PATH):
        return 127, f"{argv[0] if argv else 'Command'} is not installed."
    try:
        result = subprocess.run(
            argv, check=False, capture_output=True, text=True,
            timeout=timeout, env=session_env(),
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        return 1, str(exc)
    return result.returncode, result.stdout.strip() or result.stderr.strip() or "No output."


def detached(argv: list[str]) -> tuple[bool, str]:
    if not argv or not shutil.which(argv[0], path=BASE_PATH):
        return False, f"{argv[0] if argv else 'Command'} is not installed."
    try:
        subprocess.Popen(argv, start_new_session=True, env=session_env())
        return True, ""
    except OSError as exc:
        return False, str(exc)


def read_state() -> dict[str, object]:
    try:
        payload = json.loads(STATE_FILE.read_text(encoding="utf-8"))
        return payload if isinstance(payload, dict) else {}
    except (OSError, ValueError):
        return {}


def save_state(payload: dict[str, object]) -> None:
    STATE_FILE.parent.mkdir(parents=True, exist_ok=True)
    temporary = STATE_FILE.with_suffix(".tmp")
    temporary.write_text(json.dumps(payload, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    os.chmod(temporary, 0o600)
    temporary.replace(STATE_FILE)


def write_hypr_override(payload: dict[str, object]) -> None:
    layout = str(payload.get("keyboard_layout", "us"))
    if not re.fullmatch(r"[A-Za-z0-9_-]{1,32}", layout):
        layout = "us"
    reduced = bool(payload.get("reduced_motion", True))
    HYPR_OVERRIDE.parent.mkdir(parents=True, exist_ok=True)
    temporary = HYPR_OVERRIDE.with_suffix(".tmp")
    temporary.write_text(
        "# Generated by Edemint Settings.\n"
        f"input {{\n    kb_layout = {layout}\n}}\n"
        f"animations {{\n    enabled = {'false' if reduced else 'true'}\n}}\n",
        encoding="utf-8",
    )
    temporary.replace(HYPR_OVERRIDE)


def label(text: str, monospace: bool = False) -> Gtk.Label:
    widget = Gtk.Label(label=text, xalign=0, selectable=True)
    widget.set_wrap(True)
    if monospace:
        widget.add_css_class("monospace")
    return widget


def scrolled(child: Gtk.Widget) -> Gtk.ScrolledWindow:
    view = Gtk.ScrolledWindow(vexpand=True, hexpand=True)
    view.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
    view.set_child(child)
    return view


class Settings(Adw.Application):
    def __init__(self, arguments: list[str]) -> None:
        super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.NON_UNIQUE)
        self.arguments = arguments
        self.window: Adw.ApplicationWindow | None = None
        self.stack = Gtk.Stack(transition_type=Gtk.StackTransitionType.CROSSFADE,
                               hexpand=True, vexpand=True)
        self.split: Adw.OverlaySplitView | None = None
        self.sidebar = Gtk.ListBox(selection_mode=Gtk.SelectionMode.SINGLE)
        self.rows: dict[Gtk.ListBoxRow, tuple[str, str]] = {}
        self.status = Gtk.Label(xalign=0)
        self.display_rollback: tuple[str, str, str] | None = None
        self.timers: dict[str, int] = {}
        self.state = read_state()

    def do_activate(self) -> None:
        self.window = Adw.ApplicationWindow(application=self)
        self.window.set_title("Settings")
        self.window.set_default_size(1120, 760)
        toolbar = Adw.ToolbarView()
        header = Adw.HeaderBar()
        sidebar_toggle = Gtk.ToggleButton(icon_name="sidebar-show-symbolic", active=True)
        sidebar_toggle.add_css_class("flat")
        header.pack_start(sidebar_toggle)
        toolbar.add_top_bar(header)
        toolbar.set_content(self.build_shell())
        sidebar_toggle.bind_property(
            "active", self.split, "show-sidebar",
            GLib.BindingFlags.BIDIRECTIONAL | GLib.BindingFlags.SYNC_CREATE,
        )
        self.window.set_content(toolbar)
        if DESIGN:
            DESIGN.style_window(self.window)
            DESIGN.breakpoint_collapse(self.window, self.split)
        self.window.present()
        self.select_page(self.requested_page())

    def requested_page(self) -> str:
        for argument in self.arguments:
            value = argument
            if value.startswith("--page="):
                value = value.split("=", 1)[1]
            elif value.startswith("edemint-settings:"):
                value = value.split(":", 1)[1].lstrip("/")
            if value in PAGE_NAMES:
                return value
        return "overview"

    def build_shell(self) -> Gtk.Widget:
        sidebar_box = Gtk.Box(
            orientation=Gtk.Orientation.VERTICAL, spacing=8,
            margin_top=12, margin_bottom=12, margin_start=12, margin_end=12,
        )
        search = Gtk.SearchEntry(placeholder_text="Search settings")
        search.connect("search-changed", self.on_search)
        sidebar_box.append(search)
        self.sidebar.add_css_class("navigation-sidebar")
        for key, title, icon, keywords in PAGES:
            row = Gtk.ListBoxRow()
            line = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12,
                           margin_top=9, margin_bottom=9)
            line.append(Gtk.Image.new_from_icon_name(icon))
            line.append(Gtk.Label(label=title, xalign=0))
            row.set_child(line)
            self.sidebar.append(row)
            self.rows[row] = (key, f"{title} {keywords}".casefold())
        self.sidebar.connect("row-activated", self.on_page_row)
        sidebar_box.append(scrolled(self.sidebar))
        builders: dict[str, Callable[[], Gtk.Widget]] = {
            "overview": self.page_overview, "connections": self.page_connections,
            "sound": self.page_sound, "display": self.page_display,
            "power": self.page_power, "notifications": self.page_notifications,
            "privacy": self.page_privacy, "accounts": self.page_accounts,
            "language": self.page_language, "accessibility": self.page_accessibility,
            "updates": self.page_updates, "defaults": self.page_defaults,
            "storage": self.page_storage, "backup": self.page_backup,
            "recovery": self.page_recovery, "security": self.page_security,
        }
        for key, _title, _icon, _keywords in PAGES:
            self.stack.add_named(builders[key](), key)
        content = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        content.append(self.stack)
        status_box = Gtk.Box(margin_start=16, margin_end=16, margin_top=6, margin_bottom=8)
        self.status.set_hexpand(True)
        status_box.append(self.status)
        content.append(status_box)
        self.split = Adw.OverlaySplitView(sidebar=sidebar_box, content=content, vexpand=True)
        self.split.set_min_sidebar_width(232)
        self.split.set_max_sidebar_width(280)
        return self.split

    def page_box(self, title: str, summary: str) -> Gtk.Box:
        box = Gtk.Box(
            orientation=Gtk.Orientation.VERTICAL, spacing=18,
            margin_top=24, margin_bottom=24, margin_start=28, margin_end=28,
        )
        if DESIGN:
            box.append(DESIGN.hero(title, summary))
        else:
            heading = Gtk.Label(label=title, xalign=0)
            heading.add_css_class("title-1")
            box.append(heading)
            box.append(label(summary))
        return box

    @staticmethod
    def group(title: str, description: str = "") -> Adw.PreferencesGroup:
        return Adw.PreferencesGroup(title=title, description=description)

    def action_row(self, title: str, subtitle: str, button_label: str,
                   callback: Callable[[], None], sensitive: bool = True) -> Adw.ActionRow:
        row = Adw.ActionRow(title=title, subtitle=subtitle)
        button = Gtk.Button(label=button_label, valign=Gtk.Align.CENTER, sensitive=sensitive)
        button.connect("clicked", lambda _button: callback())
        row.add_suffix(button)
        row.set_activatable_widget(button)
        return row

    def switch_row(self, title: str, subtitle: str, active: bool,
                   callback: Callable[[bool], None]) -> Adw.ActionRow:
        row = Adw.ActionRow(title=title, subtitle=subtitle)
        toggle = Gtk.Switch(active=active, valign=Gtk.Align.CENTER)
        toggle.connect("notify::active", lambda widget, _param: callback(widget.get_active()))
        row.add_suffix(toggle)
        row.set_activatable_widget(toggle)
        return row

    def output_row(self, title: str, command: list[str], timeout: float = 8.0) -> Adw.ExpanderRow:
        code, output = capture(command, timeout)
        row = Adw.ExpanderRow(title=title, subtitle="Available" if code == 0 else "Unavailable or inactive")
        output_label = label(output, monospace=True)
        output_label.set_margin_top(8)
        output_label.set_margin_bottom(8)
        output_label.set_margin_start(12)
        output_label.set_margin_end(12)
        row.add_row(output_label)
        return row

    def notice(self, heading: str, body: str) -> None:
        if not self.window:
            return
        dialog = Adw.AlertDialog(heading=heading, body=body)
        dialog.add_response("ok", "OK")
        dialog.present(self.window)

    def confirm(self, heading: str, body: str, callback: Callable[[], None]) -> None:
        if not self.window:
            return
        dialog = Adw.AlertDialog(heading=heading, body=body)
        dialog.add_response("cancel", "Cancel")
        dialog.add_response("continue", "Continue")
        dialog.set_response_appearance("continue", Adw.ResponseAppearance.DESTRUCTIVE)
        dialog.set_default_response("cancel")
        dialog.set_close_response("cancel")
        dialog.connect("response", lambda _dialog, response: callback() if response == "continue" else None)
        dialog.present(self.window)

    def task(self, description: str, argv: list[str], timeout: float = 1800.0,
             done: Callable[[], None] | None = None) -> None:
        self.status.set_label(f"{description}...")

        def worker() -> None:
            code, output = capture(argv, timeout)

            def finish() -> bool:
                self.status.set_label(f"{description}: {'complete' if code == 0 else 'failed'}")
                if code != 0:
                    self.notice(description, output[-4000:])
                elif done:
                    done()
                return GLib.SOURCE_REMOVE

            GLib.idle_add(finish)

        threading.Thread(target=worker, daemon=True).start()

    def admin_task(self, description: str, arguments: list[str], timeout: float = 3600.0,
                   done: Callable[[], None] | None = None) -> None:
        if not Path(HELPER).is_file() or not shutil.which("pkexec", path=BASE_PATH):
            self.notice(description, "The authenticated Edemint settings helper is unavailable.")
            return
        self.task(description, ["pkexec", HELPER, *arguments], timeout, done)

    def launch(self, argv: list[str]) -> None:
        ok, error = detached(argv)
        if not ok:
            self.notice("Cannot open application", error)

    def debounce(self, name: str, callback: Callable[[], None]) -> None:
        previous = self.timers.pop(name, 0)
        if previous:
            GLib.source_remove(previous)

        def fire() -> bool:
            self.timers.pop(name, None)
            callback()
            return GLib.SOURCE_REMOVE

        self.timers[name] = GLib.timeout_add(250, fire)

    def on_search(self, entry: Gtk.SearchEntry) -> None:
        query = entry.get_text().strip().casefold()
        first: Gtk.ListBoxRow | None = None
        for row, (_key, blob) in self.rows.items():
            visible = not query or query in blob
            row.set_visible(visible)
            if visible and first is None:
                first = row
        if query and first:
            self.sidebar.select_row(first)
            self.on_page_row(self.sidebar, first)

    def on_page_row(self, _box: Gtk.ListBox, row: Gtk.ListBoxRow) -> None:
        self.stack.set_visible_child_name(self.rows[row][0])

    def select_page(self, key: str) -> None:
        self.stack.set_visible_child_name(key)
        for row, (candidate, _blob) in self.rows.items():
            if candidate == key:
                self.sidebar.select_row(row)
                break

    def page_overview(self) -> Gtk.Widget:
        box = self.page_box("Overview", "Identity, release, kernel, session, hardware, and service health.")
        group = self.group("System")
        group.add(self.output_row("Operating system", ["sh", "-c", "cat /etc/os-release; uname -srmo"]))
        group.add(self.output_row("Desktop session", ["sh", "-c", "printf 'type=%s desktop=%s\\n' \"$XDG_SESSION_TYPE\" \"$XDG_CURRENT_DESKTOP\"; loginctl show-session \"$XDG_SESSION_ID\" -p Type -p State -p Remote 2>/dev/null || true"]))
        group.add(self.output_row("Hardware", ["sh", "-c", "lscpu | sed -n '1,16p'; printf '\nMemory\n'; free -h"]))
        box.append(group)
        diagnostics = self.group("Diagnostics")
        diagnostics.add(self.action_row("Edemint Doctor", "Generate a read-only health report.", "Open", lambda: self.launch(["foot", "-T", "Edemint Doctor", "-e", "edemint-doctor"])))
        diagnostics.add(self.action_row("Activity Monitor", "Inspect resources, processes, GPU and sensors.", "Open", lambda: self.launch(["edemint-activity-monitor"])))
        diagnostics.add(self.action_row("Console", "Inspect structured logs and create a redacted support bundle.", "Open", lambda: self.launch(["edemint-console"])))
        box.append(diagnostics)
        return scrolled(box)

    def page_connections(self) -> Gtk.Widget:
        box = self.page_box("Connections", "Control radios and inspect NetworkManager and Bluetooth state.")
        network = self.group("Network")
        _code, wifi = capture(["nmcli", "radio", "wifi"])
        network.add(self.switch_row("Wi-Fi", "NetworkManager Wi-Fi radio", wifi.strip() == "enabled", lambda value: self.task("Changing Wi-Fi", ["nmcli", "radio", "wifi", "on" if value else "off"])))
        network.add(self.output_row("Connection state", ["nmcli", "-t", "-f", "DEVICE,TYPE,STATE,CONNECTION", "device"]))
        network.add(self.action_row("Connection editor", "Wi-Fi, Ethernet, VPN and WireGuard profiles.", "Open", lambda: self.launch(["nm-connection-editor"])))
        box.append(network)
        bluetooth = self.group("Bluetooth")
        _code, state = capture(["bluetoothctl", "show"])
        bluetooth.add(self.switch_row("Bluetooth radio", "BlueZ adapter power", "Powered: yes" in state, lambda value: self.task("Changing Bluetooth", ["bluetoothctl", "power", "on" if value else "off"])))
        bluetooth.add(self.output_row("Adapter state", ["bluetoothctl", "show"]))
        bluetooth.add(self.action_row("Bluetooth Manager", "Pair, trust, connect and remove devices.", "Open", lambda: self.launch(["blueman-manager"])))
        box.append(bluetooth)
        return scrolled(box)

    @staticmethod
    def volume_percent(target: str) -> tuple[float, bool]:
        _code, output = capture(["wpctl", "get-volume", target])
        match = re.search(r"Volume:\s+([0-9.]+)", output)
        return ((float(match.group(1)) * 100.0) if match else 0.0, "[MUTED]" in output)

    def volume_group(self, title: str, target: str, maximum: float) -> Adw.PreferencesGroup:
        value, muted = self.volume_percent(target)
        group = self.group(title)
        row = Adw.ActionRow(title="Level", subtitle="PipeWire/WirePlumber")
        scale = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, maximum, 1)
        scale.set_value(value)
        scale.set_draw_value(True)
        scale.set_value_pos(Gtk.PositionType.RIGHT)
        scale.set_size_request(240, -1)
        scale.set_hexpand(True)
        scale.connect("value-changed", lambda widget: self.debounce(target, lambda: self.task(f"Setting {title.lower()}", ["wpctl", "set-volume", "-l", str(maximum / 100.0), target, f"{int(widget.get_value())}%"])))
        row.add_suffix(scale)
        group.add(row)
        group.add(self.switch_row("Mute", f"Mute {title.lower()}", muted, lambda active: self.task(f"Changing {title.lower()} mute", ["wpctl", "set-mute", target, "1" if active else "0"])))
        return group

    def page_sound(self) -> Gtk.Widget:
        box = self.page_box("Sound", "Native master output and microphone controls with advanced routing.")
        box.append(self.volume_group("Output", "@DEFAULT_AUDIO_SINK@", 150.0))
        box.append(self.volume_group("Microphone", "@DEFAULT_AUDIO_SOURCE@", 100.0))
        group = self.group("Routing")
        group.add(self.action_row("Advanced audio routing", "Per-app streams, devices, profiles and ports.", "Open", lambda: self.launch(["pavucontrol"])))
        group.add(self.output_row("PipeWire status", ["wpctl", "status"]))
        box.append(group)
        return scrolled(box)

    def display_snapshot(self) -> tuple[str, str, str] | None:
        code, output = capture(["wlr-randr", "--json"])
        if code:
            return None
        try:
            display = next(item for item in json.loads(output) if item.get("enabled"))
            return str(display["name"]), str(display.get("scale", 1.0)), str(display.get("transform", "normal"))
        except (ValueError, StopIteration, KeyError, TypeError):
            return None

    def page_display(self) -> Gtk.Widget:
        box = self.page_box("Display", "Adjust brightness, scale and rotation, with explicit in-session revert.")
        brightness_group = self.group("Brightness")
        _code, current = capture(["brightnessctl", "-m"])
        match = re.search(r",([0-9]+)%,", current)
        brightness_row = Adw.ActionRow(title="Built-in display brightness", subtitle="Disabled when no backlight is exposed")
        brightness = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 1, 100, 1)
        brightness.set_value(float(match.group(1)) if match else 50.0)
        brightness.set_draw_value(True)
        brightness.set_size_request(240, -1)
        brightness.set_hexpand(True)
        brightness.set_sensitive(match is not None)
        brightness.connect("value-changed", lambda widget: self.debounce("brightness", lambda: self.task("Setting brightness", ["brightnessctl", "set", f"{int(widget.get_value())}%"])))
        brightness_row.add_suffix(brightness)
        brightness_group.add(brightness_row)
        box.append(brightness_group)

        group = self.group("Output configuration", "Apply validates the output; Revert restores the captured values.")
        snapshot = self.display_snapshot()
        output = Gtk.Entry(text=snapshot[0] if snapshot else "", placeholder_text="eDP-1")
        scale = Gtk.SpinButton.new_with_range(0.5, 3.0, 0.25)
        scale.set_value(float(snapshot[1]) if snapshot else 1.0)
        transforms = ["normal", "90", "180", "270", "flipped", "flipped-90", "flipped-180", "flipped-270"]
        transform = Gtk.DropDown.new_from_strings(transforms)
        if snapshot and snapshot[2] in transforms:
            transform.set_selected(transforms.index(snapshot[2]))
        for title, widget in (("Output", output), ("Scale", scale), ("Rotation", transform)):
            row = Adw.ActionRow(title=title)
            row.add_suffix(widget)
            group.add(row)

        def apply_display() -> None:
            name = output.get_text().strip()
            if not re.fullmatch(r"[A-Za-z0-9_.:-]{1,64}", name):
                self.notice("Display", "Enter a valid detected output name.")
                return
            previous = self.display_snapshot()
            selected = transform.get_selected_item()
            rotation = selected.get_string() if selected else "normal"
            self.task("Applying display configuration", ["wlr-randr", "--output", name, "--scale", f"{scale.get_value():.2f}", "--transform", rotation], done=lambda: setattr(self, "display_rollback", previous))

        def revert_display() -> None:
            if not self.display_rollback:
                self.notice("Display", "No display change was captured in this Settings session.")
                return
            name, old_scale, old_transform = self.display_rollback
            self.task("Reverting display configuration", ["wlr-randr", "--output", name, "--scale", old_scale, "--transform", old_transform])

        group.add(self.action_row("Apply", "Apply scale and rotation.", "Apply", apply_display))
        group.add(self.action_row("Revert last change", "Restore the captured output state.", "Revert", revert_display))
        group.add(self.output_row("Detected outputs", ["wlr-randr"]))
        box.append(group)
        return scrolled(box)

    def page_power(self) -> Gtk.Widget:
        box = self.page_box("Power", "Choose a supported power profile and inspect battery capability.")
        group = self.group("Power profile")
        _code, current = capture(["powerprofilesctl", "get"])
        profiles = ["power-saver", "balanced", "performance"]
        choice = Gtk.DropDown.new_from_strings(profiles)
        if current.strip() in profiles:
            choice.set_selected(profiles.index(current.strip()))
        row = Adw.ActionRow(title="Profile", subtitle="Unsupported choices are rejected by power-profiles-daemon")
        row.add_suffix(choice)
        group.add(row)
        group.add(self.action_row("Apply profile", "Apply the selected capability-aware profile.", "Apply", lambda: self.task("Changing power profile", ["powerprofilesctl", "set", choice.get_selected_item().get_string()])))
        group.add(self.output_row("Available profiles", ["powerprofilesctl", "list"]))
        group.add(self.output_row("Battery devices", ["upower", "-e"]))
        box.append(group)
        return scrolled(box)

    def page_notifications(self) -> Gtk.Widget:
